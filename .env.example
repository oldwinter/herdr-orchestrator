# Optional exporters are fail-closed and disabled unless their feature flag is true.
HERDR_FEATURE_SENTRY_EXPORT=false
SENTRY_DSN=

HERDR_FEATURE_POSTHOG_ANALYTICS=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

HERDR_FEATURE_WEBHOOK_ALERTS=false
HERDR_ALERT_WEBHOOK_URL=

# Included in exported error events. Do not put credentials in this value.
HERDR_RELEASE=development
