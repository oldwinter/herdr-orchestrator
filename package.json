{
  "name": "herdr-orchestrator",
  "version": "0.1.2",
  "description": "Install and run durable multi-harness orchestration over Herdr",
  "keywords": [
    "agents",
    "herdr",
    "orchestration",
    "codex",
    "claude",
    "droid"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "herdr-orchestrator": "bin/herdr-orchestrator.mjs"
  },
  "files": [
    "bin/",
    "manager/",
    "profiles/",
    "skills/",
    "src/herdr_orchestrator/**/*.py",
    "src/herdr_orchestrator/dashboard/static/*.html",
    "src/herdr_orchestrator/dashboard/static/*.css",
    "src/herdr_orchestrator/dashboard/static/*.js",
    "src/herdr_orchestrator/dashboard/static/*.txt",
    "workflows/prompts/planner.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "release:plan": "node scripts/npm-release-plan.mjs --package-json package.json",
    "test": "python3 -m unittest tests.test_distribution -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldwinter/herdr-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/oldwinter/herdr-orchestrator/issues"
  },
  "homepage": "https://github.com/oldwinter/herdr-orchestrator#readme"
}
